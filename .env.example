# Copy to .env and adjust. Never commit real secrets.

# development | test | production
APP_ENV=development

# Signs session cookies and approval tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite works out of the box. For Postgres: postgresql+psycopg://lantern:password@db:5432/lantern
DATABASE_URL=sqlite:///./data/lantern.db

# Private storage for uploaded documents and generated claim packs (never served directly)
UPLOAD_DIR=./data/uploads
OPERATION_LOG_DIR=./logs/operations

# auto = use the Claude API when ANTHROPIC_API_KEY is set, otherwise the offline deterministic planner
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=1800

# Cookies: set true behind HTTPS in production
COOKIE_SECURE=false

# Approval cards expire after this many minutes
APPROVAL_TTL_MINUTES=15

# Rate limits per minute
RATE_LIMIT_ASSISTANT_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Development only: list demo accounts at /api/dev/demo-accounts
EXPOSE_DEMO_ACCOUNTS=true
