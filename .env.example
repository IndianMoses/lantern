# Copy to .env and adjust. Never commit real secrets.

# development | test | production
APP_ENV=development

# Signs session cookies and approval tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite works out of the box. For Postgres: postgresql+psycopg://lantern:password@db:5432/lantern
DATABASE_URL=sqlite:///./data/lantern.db

# Private storage for uploaded documents and generated claim packs (never served directly)
UPLOAD_DIR=./data/uploads
OPERATION_LOG_DIR=./logs/operations

# auto = use the Claude API when ANTHROPIC_API_KEY is set, otherwise the offline deterministic planner
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=1800

# Cookies: set true behind HTTPS in production
COOKIE_SECURE=false

# Approval cards expire after this many minutes
APPROVAL_TTL_MINUTES=15

# Rate limits per minute
RATE_LIMIT_ASSISTANT_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Development only: list demo accounts at /api/dev/demo-accounts
EXPOSE_DEMO_ACCOUNTS=true

# ---------------------------------------------------------------------------
# Multi-agent coverage analysis (docs/MODELS.md). Each role is an OpenAI
# compatible chat completions endpoint (vLLM, SGLang, Ollama, TGI) serving an
# open-weight model inside your own environment. auto = use the three models
# when all three URLs are set, otherwise the deterministic rule based analysts.
# A role that fails at run time falls back to the rules and the result is
# labelled "mixed"; a fallback is never presented as a model output.
ANALYSIS_MODE=auto
MODEL_A_URL=
MODEL_A_NAME=Qwen/Qwen3-32B
MODEL_A_API_KEY=
MODEL_B_URL=
MODEL_B_NAME=mistralai/Mistral-Small-3.2-24B-Instruct-2506
MODEL_B_API_KEY=
MODEL_C_URL=
MODEL_C_NAME=zai-org/GLM-4.5-Air
MODEL_C_API_KEY=
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_RETRIES=1
MODEL_MAX_TOKENS=3000
# false runs analyses synchronously in the request (tests); true uses a background worker with polling
ANALYSIS_RUN_IN_BACKGROUND=true

# Account security
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# Require TOTP for insurer admins, bank admins and platform admins (enable once staff have enrolled)
MFA_REQUIRED_FOR_PRIVILEGED=false
SESSION_TTL_HOURS=12
